# Database (SQLite for local dev; swap to Postgres in production by changing
# the `provider` in prisma/schema.prisma and this URL)
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# Google OAuth (used for "Sign in with Google" / connecting your Gmail account)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
