# --- Database (PostgreSQL) --------------------------------------------------
# The app runs on serverless functions, which open many short-lived
# connections, so DATABASE_URL must be a POOLED connection string.
# DIRECT_URL is the unpooled one: migrations cannot run through a pooler.
#
# Neon (free tier) gives you both — the pooled host has "-pooler" in it:
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/ridetrack?sslmode=require"
#   DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/ridetrack?sslmode=require"
#
# For local development, a plain local Postgres works for both:
#   docker run --name ridetrack-db -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=ridetrack -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ridetrack"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ridetrack"

# --- NextAuth ---------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# --- Google OAuth -----------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add an authorized redirect URI for EVERY origin you sign in from:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-project>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
