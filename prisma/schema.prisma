generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- NextAuth models -------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  bio           String?
  homeState     String?
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]

  rideStatuses UserRideStatus[]
  checkIns     CheckIn[]

  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain models -----------------------------------------------------

enum ParkChain {
  DISNEY
  UNIVERSAL
  SIX_FLAGS
  CEDAR_FAIR
  SEAWORLD
  HERSCHEND
  INDEPENDENT
  OTHER
}

model Park {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  chain       ParkChain @default(INDEPENDENT)
  city        String
  state       String
  country     String    @default("USA")
  latitude    Float?
  longitude   Float?
  website     String?
  description String?
  createdAt   DateTime  @default(now())

  rides    Ride[]
  checkIns CheckIn[]

  @@index([state])
  @@index([chain])
}

enum RideType {
  ROLLER_COASTER
  DARK_RIDE
  WATER_RIDE
  FLAT_RIDE
  KIDDIE
  TRANSPORT
  SHOW
  OTHER
}

model Ride {
  id           String   @id @default(cuid())
  slug         String
  name         String
  parkId       String
  type         RideType @default(OTHER)
  manufacturer String?
  opened       Int?
  description  String?
  createdAt    DateTime @default(now())

  park         Park             @relation(fields: [parkId], references: [id], onDelete: Cascade)
  userStatuses UserRideStatus[]

  @@unique([parkId, slug])
  @@index([parkId])
}

enum RideStatus {
  WANT_TO_RIDE
  RIDDEN
}

model UserRideStatus {
  id        String     @id @default(cuid())
  userId    String
  rideId    String
  status    RideStatus @default(WANT_TO_RIDE)
  favorite  Boolean    @default(false)
  rating    Int?
  notes     String?
  riddenAt  DateTime?
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([userId, rideId])
  @@index([rideId])
}

enum Visibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

model CheckIn {
  id          String     @id @default(cuid())
  userId      String
  parkId      String
  checkedInAt DateTime   @default(now())
  note        String?
  visibility  Visibility @default(FRIENDS)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parkId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}
